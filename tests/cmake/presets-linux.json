{
  "version": 4,
  "cmakeMinimumRequired": { "major": 3, "minor": 23, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "LIBEDHOC_ENABLE_TESTS": "ON",
        "CONFIG_LIBEDHOC_ENABLE": "1",
        "CONFIG_LIBEDHOC_KEY_ID_LEN": "4",
        "CONFIG_LIBEDHOC_MAX_NR_OF_CIPHER_SUITES": "3",
        "CONFIG_LIBEDHOC_MAX_NR_OF_METHODS": "4",
        "CONFIG_LIBEDHOC_MAX_LEN_OF_CONN_ID": "7",
        "CONFIG_LIBEDHOC_MAX_NR_OF_EAD_TOKENS": "3",
        "CONFIG_LIBEDHOC_MAX_NR_OF_CERTS_IN_X509_CHAIN": "2",
        "CONFIG_LIBEDHOC_LOG_LEVEL": "4",
        "ENABLE_PROGRAMS": "OFF",
        "ENABLE_TESTING": "OFF"
      }
    },

    {
      "name": "eph-x25519",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CONFIG_LIBEDHOC_CIPHER_SUITE_0_ENABLE": "1",
        "CONFIG_LIBEDHOC_CIPHER_SUITE_2_ENABLE": "0",
        "CONFIG_LIBEDHOC_CIPHER_SUITE_4_ENABLE": "1",
        "CONFIG_LIBEDHOC_CIPHER_SUITE_24_ENABLE": "0",
        "CONFIG_LIBEDHOC_CIPHER_SUITE_PQC_1_ENABLE": "0",
        "CONFIG_LIBEDHOC_MAX_LEN_OF_KEM_ENCAPSULATION_KEY": "32",
        "CONFIG_LIBEDHOC_MAX_LEN_OF_KEM_CIPHERTEXT": "32",
        "CONFIG_LIBEDHOC_MAX_LEN_OF_NIKE_KEY": "32",
        "CONFIG_LIBEDHOC_MAX_LEN_OF_MAC": "32"
      }
    },
    {
      "name": "eph-p256",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CONFIG_LIBEDHOC_CIPHER_SUITE_0_ENABLE": "0",
        "CONFIG_LIBEDHOC_CIPHER_SUITE_2_ENABLE": "1",
        "CONFIG_LIBEDHOC_CIPHER_SUITE_4_ENABLE": "0",
        "CONFIG_LIBEDHOC_CIPHER_SUITE_24_ENABLE": "0",
        "CONFIG_LIBEDHOC_CIPHER_SUITE_PQC_1_ENABLE": "0",
        "CONFIG_LIBEDHOC_MAX_LEN_OF_KEM_ENCAPSULATION_KEY": "65",
        "CONFIG_LIBEDHOC_MAX_LEN_OF_KEM_CIPHERTEXT": "65",
        "CONFIG_LIBEDHOC_MAX_LEN_OF_NIKE_KEY": "65",
        "CONFIG_LIBEDHOC_MAX_LEN_OF_MAC": "32"
      }
    },
    {
      "name": "eph-p384",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CONFIG_LIBEDHOC_CIPHER_SUITE_0_ENABLE": "0",
        "CONFIG_LIBEDHOC_CIPHER_SUITE_2_ENABLE": "0",
        "CONFIG_LIBEDHOC_CIPHER_SUITE_4_ENABLE": "0",
        "CONFIG_LIBEDHOC_CIPHER_SUITE_24_ENABLE": "1",
        "CONFIG_LIBEDHOC_CIPHER_SUITE_PQC_1_ENABLE": "0",
        "CONFIG_LIBEDHOC_MAX_LEN_OF_KEM_ENCAPSULATION_KEY": "97",
        "CONFIG_LIBEDHOC_MAX_LEN_OF_KEM_CIPHERTEXT": "97",
        "CONFIG_LIBEDHOC_MAX_LEN_OF_NIKE_KEY": "97",
        "CONFIG_LIBEDHOC_MAX_LEN_OF_MAC": "48"
      }
    },
    {
      "name": "eph-mlkem512",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CONFIG_LIBEDHOC_CIPHER_SUITE_0_ENABLE": "0",
        "CONFIG_LIBEDHOC_CIPHER_SUITE_2_ENABLE": "0",
        "CONFIG_LIBEDHOC_CIPHER_SUITE_4_ENABLE": "0",
        "CONFIG_LIBEDHOC_CIPHER_SUITE_24_ENABLE": "0",
        "CONFIG_LIBEDHOC_CIPHER_SUITE_PQC_1_ENABLE": "1",
        "CONFIG_LIBEDHOC_MAX_LEN_OF_KEM_ENCAPSULATION_KEY": "800",
        "CONFIG_LIBEDHOC_MAX_LEN_OF_KEM_CIPHERTEXT": "768",
        "CONFIG_LIBEDHOC_MAX_LEN_OF_NIKE_KEY": "32",
        "CONFIG_LIBEDHOC_MAX_LEN_OF_MAC": "64"
      }
    },

    { "name": "backend-stack",  "hidden": true, "cacheVariables": { "CONFIG_LIBEDHOC_MEM_BACKEND": "0" } },
    { "name": "backend-heap",   "hidden": true, "cacheVariables": { "CONFIG_LIBEDHOC_MEM_BACKEND": "1" } },
    { "name": "backend-custom", "hidden": true, "cacheVariables": { "CONFIG_LIBEDHOC_MEM_BACKEND": "2" } },

    { "name": "x25519_stack",    "displayName": "X25519 (suites 0,4) / stack",  "inherits": ["eph-x25519",  "backend-stack"],  "binaryDir": "${sourceDir}/build/x25519_stack" },
    { "name": "x25519_heap",     "displayName": "X25519 (suites 0,4) / heap",   "inherits": ["eph-x25519",  "backend-heap"],   "binaryDir": "${sourceDir}/build/x25519_heap" },
    { "name": "x25519_custom",   "displayName": "X25519 (suites 0,4) / custom", "inherits": ["eph-x25519",  "backend-custom"], "binaryDir": "${sourceDir}/build/x25519_custom" },

    { "name": "p256_stack",      "displayName": "P-256 (suite 2) / stack",   "inherits": ["eph-p256",     "backend-stack"],  "binaryDir": "${sourceDir}/build/p256_stack" },
    { "name": "p256_heap",       "displayName": "P-256 (suite 2) / heap",    "inherits": ["eph-p256",     "backend-heap"],   "binaryDir": "${sourceDir}/build/p256_heap" },
    { "name": "p256_custom",     "displayName": "P-256 (suite 2) / custom",  "inherits": ["eph-p256",     "backend-custom"], "binaryDir": "${sourceDir}/build/p256_custom" },

    { "name": "p384_stack",      "displayName": "P-384 (suite 24) / stack",  "inherits": ["eph-p384",     "backend-stack"],  "binaryDir": "${sourceDir}/build/p384_stack" },
    { "name": "p384_heap",       "displayName": "P-384 (suite 24) / heap",   "inherits": ["eph-p384",     "backend-heap"],   "binaryDir": "${sourceDir}/build/p384_heap" },
    { "name": "p384_custom",     "displayName": "P-384 (suite 24) / custom", "inherits": ["eph-p384",     "backend-custom"], "binaryDir": "${sourceDir}/build/p384_custom" },

    { "name": "mlkem512_stack",  "displayName": "ML-KEM-512 (suite pqc_1) / stack",  "inherits": ["eph-mlkem512", "backend-stack"],  "binaryDir": "${sourceDir}/build/mlkem512_stack" },
    { "name": "mlkem512_heap",   "displayName": "ML-KEM-512 (suite pqc_1) / heap",   "inherits": ["eph-mlkem512", "backend-heap"],   "binaryDir": "${sourceDir}/build/mlkem512_heap" },
    { "name": "mlkem512_custom", "displayName": "ML-KEM-512 (suite pqc_1) / custom", "inherits": ["eph-mlkem512", "backend-custom"], "binaryDir": "${sourceDir}/build/mlkem512_custom" },

    {
      "name": "p256_limits",
      "displayName": "P-256 (suite 2) / stack, maximum X.509 chain",
      "inherits": ["eph-p256", "backend-stack"],
      "binaryDir": "${sourceDir}/build/p256_limits",
      "cacheVariables": {
        "CONFIG_LIBEDHOC_MAX_NR_OF_CERTS_IN_X509_CHAIN": "3"
      }
    },

    {
      "name": "legacy",
      "displayName": "All suites + unit monolith (transitional)",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/legacy",
      "cacheVariables": {
        "CONFIG_LIBEDHOC_CIPHER_SUITE_0_ENABLE": "1",
        "CONFIG_LIBEDHOC_CIPHER_SUITE_2_ENABLE": "1",
        "CONFIG_LIBEDHOC_CIPHER_SUITE_4_ENABLE": "1",
        "CONFIG_LIBEDHOC_CIPHER_SUITE_24_ENABLE": "1",
        "CONFIG_LIBEDHOC_CIPHER_SUITE_PQC_1_ENABLE": "1",
        "CONFIG_LIBEDHOC_MEM_BACKEND": "0",
        "CONFIG_LIBEDHOC_MAX_LEN_OF_KEM_ENCAPSULATION_KEY": "800",
        "CONFIG_LIBEDHOC_MAX_LEN_OF_KEM_CIPHERTEXT": "768",
        "CONFIG_LIBEDHOC_MAX_LEN_OF_NIKE_KEY": "48",
        "CONFIG_LIBEDHOC_MAX_LEN_OF_MAC": "64"
      }
    },

    {
      "name": "clang",
      "displayName": "Clang + Ninja (all suites)",
      "inherits": "legacy",
      "binaryDir": "${sourceDir}/build/clang",
      "cacheVariables": { "CMAKE_C_COMPILER": "clang-20" }
    },
    {
      "name": "clang-latest",
      "displayName": "Clang, unpinned (early warning, non-blocking in CI)",
      "inherits": "clang",
      "binaryDir": "${sourceDir}/build/clang-latest",
      "cacheVariables": { "CMAKE_C_COMPILER": "clang" }
    },
    {
      "name": "coverage",
      "displayName": "GCC + gcov (all suites)",
      "inherits": "legacy",
      "binaryDir": "${sourceDir}/build/coverage",
      "cacheVariables": { "LIBEDHOC_ENABLE_COVERAGE": "ON" }
    },
    {
      "name": "valgrind",
      "displayName": "Valgrind memcheck/DRD (all suites, portable liboqs)",
      "inherits": "legacy",
      "binaryDir": "${sourceDir}/build/valgrind",
      "cacheVariables": {
        "OQS_OPT_TARGET": "generic",
        "CMAKE_C_FLAGS": "-gdwarf-4"
      }
    },
    {
      "name": "asan",
      "displayName": "GCC + ASan/UBSan (all suites)",
      "inherits": "legacy",
      "binaryDir": "${sourceDir}/build/asan",
      "cacheVariables": { "LIBEDHOC_ENABLE_SANITIZERS": "ON" }
    },
    {
      "name": "fuzz",
      "displayName": "Clang + libFuzzer",
      "inherits": "eph-p256",
      "binaryDir": "${sourceDir}/build/fuzz",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-20",
        "LIBEDHOC_ENABLE_TESTS": "OFF",
        "LIBEDHOC_ENABLE_FUZZING": "ON"
      }
    },
    {
      "name": "no_cipher_suites",
      "displayName": "Library build with every cipher suite disabled (compile check)",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/no_cipher_suites",
      "cacheVariables": {
        "LIBEDHOC_ENABLE_TESTS": "OFF",
        "CONFIG_LIBEDHOC_CIPHER_SUITE_0_ENABLE": "0",
        "CONFIG_LIBEDHOC_CIPHER_SUITE_2_ENABLE": "0",
        "CONFIG_LIBEDHOC_CIPHER_SUITE_4_ENABLE": "0",
        "CONFIG_LIBEDHOC_CIPHER_SUITE_24_ENABLE": "0",
        "CONFIG_LIBEDHOC_CIPHER_SUITE_PQC_1_ENABLE": "0"
      }
    }
  ],

  "buildPresets": [
    { "name": "x25519_stack",    "configurePreset": "x25519_stack" },
    { "name": "x25519_heap",     "configurePreset": "x25519_heap" },
    { "name": "x25519_custom",   "configurePreset": "x25519_custom" },
    { "name": "p256_stack",      "configurePreset": "p256_stack" },
    { "name": "p256_heap",       "configurePreset": "p256_heap" },
    { "name": "p256_custom",     "configurePreset": "p256_custom" },
    { "name": "p384_stack",      "configurePreset": "p384_stack" },
    { "name": "p384_heap",       "configurePreset": "p384_heap" },
    { "name": "p384_custom",     "configurePreset": "p384_custom" },
    { "name": "mlkem512_stack",  "configurePreset": "mlkem512_stack" },
    { "name": "mlkem512_heap",   "configurePreset": "mlkem512_heap" },
    { "name": "mlkem512_custom", "configurePreset": "mlkem512_custom" },
    { "name": "p256_limits",     "configurePreset": "p256_limits" },
    { "name": "legacy",          "configurePreset": "legacy" },
    { "name": "clang",           "configurePreset": "clang" },
    { "name": "clang-latest",    "configurePreset": "clang-latest" },
    { "name": "coverage",        "configurePreset": "coverage" },
    { "name": "valgrind",        "configurePreset": "valgrind" },
    { "name": "asan",            "configurePreset": "asan" },
    { "name": "fuzz",            "configurePreset": "fuzz" },
    { "name": "no_cipher_suites", "configurePreset": "no_cipher_suites" }
  ],

  "testPresets": [
    { "name": "x25519_stack",    "configurePreset": "x25519_stack",    "output": { "outputOnFailure": true } },
    { "name": "x25519_heap",     "configurePreset": "x25519_heap",     "output": { "outputOnFailure": true } },
    { "name": "x25519_custom",   "configurePreset": "x25519_custom",   "output": { "outputOnFailure": true } },
    { "name": "p256_stack",      "configurePreset": "p256_stack",      "output": { "outputOnFailure": true } },
    { "name": "p256_heap",       "configurePreset": "p256_heap",       "output": { "outputOnFailure": true } },
    { "name": "p256_custom",     "configurePreset": "p256_custom",     "output": { "outputOnFailure": true } },
    { "name": "p384_stack",      "configurePreset": "p384_stack",      "output": { "outputOnFailure": true } },
    { "name": "p384_heap",       "configurePreset": "p384_heap",       "output": { "outputOnFailure": true } },
    { "name": "p384_custom",     "configurePreset": "p384_custom",     "output": { "outputOnFailure": true } },
    { "name": "mlkem512_stack",  "configurePreset": "mlkem512_stack",  "output": { "outputOnFailure": true } },
    { "name": "mlkem512_heap",   "configurePreset": "mlkem512_heap",   "output": { "outputOnFailure": true } },
    { "name": "mlkem512_custom", "configurePreset": "mlkem512_custom", "output": { "outputOnFailure": true } },
    { "name": "p256_limits",     "configurePreset": "p256_limits",     "output": { "outputOnFailure": true } },
    { "name": "legacy",          "configurePreset": "legacy",          "output": { "outputOnFailure": true } },
    { "name": "clang",           "configurePreset": "clang",           "output": { "outputOnFailure": true } },
    { "name": "clang-latest",    "configurePreset": "clang-latest",    "output": { "outputOnFailure": true } },
    { "name": "coverage",        "configurePreset": "coverage",        "output": { "outputOnFailure": true } },
    { "name": "asan",            "configurePreset": "asan",            "output": { "outputOnFailure": true } }
  ]
}
